{
  "name": "dominicklee-notebook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0 --port 3000",
    "build": "react-router build",
    "build:netlify": "npm run build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "playwright test",
    "format": "prettier --write app tests docs scripts *.ts *.json *.md .github/workflows/*.yml",
    "format:check": "prettier --check app tests docs scripts *.ts *.json *.md .github/workflows/*.yml",
    "check": "npm run format:check && npm run typecheck && npm run build && npm run check:build",
    "check:build": "node scripts/check-build.mjs",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "isbot": "^5.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@netlify/vite-plugin-react-router": "^4.0.0",
    "@react-router/dev": "^8.4.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
